# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_VISION_MODEL=gpt-5
# 1 = отдавать фиксированные ответы из seed/fixtures вместо вызова API (страховка на демо)
DEMO_MODE=0

# приложение
