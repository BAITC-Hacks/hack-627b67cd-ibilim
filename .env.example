# LLM. Без ключа приложение работает на локальной заглушке (ai.mode = stub) — весь сценарий проходит.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# для reasoning-моделей (gpt-5*): low заметно быстрее; для остальных моделей оставьте пустым
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT=40
# 1 = не ходить в API даже при наличии ключа (страховка на демо)
DEMO_MODE=0

# БД SQLite; относительный путь считается от backend/
DB_PATH=ibilim.db
